float getDiskDensity(vec3 pos, float r)
{
    float innerRadius = 2.5; //Just outside the innermost stable circular orbit
    float outerRadius = 10.0; // Arbitrary outer radius for the disk
    float scaleHeight = 0.2; // Thickness of the disk

    if(r<innerRadius || r > outerRadius) return 0.0; // Outside the disk

    // Vertical falloff: Denser at the equator (Z=0), fading out upwards/downwards
    float verticalFalloff = exp(-(pos.z*pos.z) / (scaleHeight*scaleHeight)); // Gaussian falloff in z

    // Radial falloff: Smooth fade-in near the black hole, and smooth fade-out at the edges
    float radialFalloff = smoothstep(innerRadius, innerRadius + 1.0, r) * 
                          (1.0 - smoothstep(outerRadius - 4.0, outerRadius, r));

    // The multiplier controls the overall opacity of the gas
    return verticalFalloff * radialFalloff * 8.0;
}

void main()
{
    ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dims = imageSize(imgOutput);
    
    // Ensure we don't write outside the texture bounds
    if(pixelCoords.x >= dims.x || pixelCoords.y >= dims.y) return;

    // Remove the aspect multiplication from uv.x since we handle it in the ray direction
    vec2 uv = vec2(pixelCoords) / vec2(dims) * 2.0 - 1.0;
    float aspect = float(dims.x) / float(dims.y);

    // Calculate direction based on the camera's basis vectors
    vec3 rayDir = normalize(camFront + uv.x * aspect * camRight + uv.y * camUp);

    vec4 position = vec4(0.0, camPos.x, camPos.y, camPos.z); //Initial photon position in 4D (t, x, y, z)
    vec4 velocity = vec4(1.0, rayDir.x, rayDir.y, rayDir.z); // Initial photon speed
    vec4 finalColor = vec4(0.0, 0.0, 0.0, 1.0); // Default to black
    
    float a = spin * M; // Spin parameter
    float event_horizon = M + sqrt(M * M - a * a); // Event horizon radius

    // Variables to track volumetric rendering
    vec3 accumulatedColor = vec3(0.0);
    float transmittance = 1.0; // 1.0 means 100% of light can pass through initially
    vec3 baseEmission = vec3(1.0, 0.35, 0.05); // Deep fiery orange
    const int MAX_STEPS = 10000; // Prevent infinite loops

    for(int step = 0; step < MAX_STEPS; step++)
    {
        float r_current = length(position.yzw); // Current radial distance from the black hole

        // Spatial Scaling: Gravity is weak far away, so we can afford lower precision.
        // We scale the step size linearly with distance.
        float spatial_multiplier = max(1.0, r_current * 0.5); 

        // Volumetric Boundary Check: Are we near the plasma disk?
        // Your disk exists roughly between r=2.5 and r=10.0, and is very thin on the Z-axis.
        // (position.w represents the z-coordinate in your 4D vector)
        bool in_disk = (r_current > 2.0 && r_current < 11.0 && abs(position.w) < 0.5);

        // Final Step Size:
        // If we are intersecting the disk, we force a small multiplier (1.0x to 2.0x dt) 
        // to ensure the volumetric gas samples smoothly.
        // If we are in empty space, we take the massive spatial leaps.
        float dynamic_dt = dt * (in_disk ? 1.5 : spatial_multiplier);

        // 1. RK4 Integration
        vec4 k1_v = getAcceleration(position, velocity);
        vec4 k1_p = velocity;

        vec4 k2_v = getAcceleration(position + k1_p * (dynamic_dt * 0.5), velocity + k1_v * (dynamic_dt * 0.5));
        vec4 k2_p = velocity + k1_v * (dynamic_dt * 0.5);

        vec4 k3_v = getAcceleration(position + k2_p * (dynamic_dt * 0.5), velocity + k2_v * (dynamic_dt * 0.5));
        vec4 k3_p = velocity + k2_v * (dynamic_dt * 0.5);
        vec4 k4_v = getAcceleration(position + k3_p * dynamic_dt, velocity + k3_v * dynamic_dt);
        vec4 k4_p = velocity + k3_v * dynamic_dt;

        vec4 new_velocity = velocity + (dynamic_dt / 6.0) * (k1_v + 2.0 * k2_v + 2.0 * k3_v + k4_v);
        vec4 new_position = position + (dynamic_dt / 6.0) * (k1_p + 2.0 * k2_p + 2.0 * k3_p + k4_p);

        // 2. Event Horizon Check (Boyer-Lindquist radial coordinate))
        float r = get_r(new_position.yzw, a);
        if(r <= event_horizon * 1.05) //small padding to prevent precision collapse at singularity
        {
            finalColor = vec4(0.0, 0.0, 0.0, 1.0); // Black for inside the event horizon
            break; // Stop tracing once it crosses the event horizon
        }
        

        // 3. Volumetric Plasma Disk Integration
        //Fast bounding box check: Plasma calculations are only done if the ray is actuallt near the disk
        in_disk = (r>2.0 && r<11.0 && abs(new_position.w) <0.5);
        if(in_disk)
        {
        
            float density = getDiskDensity(new_position.yzw, r);

            if (density > 0.0) 
            {
                // 1. Calculate Plasma 4-Velocity (Cartesian Kerr approximation)
                // Angular velocity for prograde circular orbits
                float omega = 1.0 / (pow(r, 1.5) + a); 
    
                // Tangential velocity in Cartesian (x, y, z)
                vec4 u_unnorm = vec4(1.0, -omega * new_position.z, omega * new_position.y, 0.0);
    
                // Normalize 4-velocity using the Kerr metric (g_mu_nu * u^mu * u^nu = -1)
                mat4 metric = get_metric(new_position);
                vec4 metric_u = metric * u_unnorm;
                float u_norm_sq = dot(u_unnorm, metric_u);
    
                // Prevent NaN if inside the ergosphere/unstable region where u_norm_sq > 0
                vec4 u_plasma = u_unnorm;
                if (u_norm_sq < 0.0) {
                    u_plasma = u_unnorm / sqrt(-u_norm_sq);
                }

                // 2. Calculate Doppler Factor (g)
                // p_em = g_mu_nu * p^mu (lowering the index of the photon's 4-velocity)
                vec4 p_lower = metric * new_velocity;
                float p_dot_u = dot(p_lower, u_plasma); // E_em = -p_dot_u
    
                // g = E_obs / E_em (Assuming E_obs is approx 1.0 at the camera)
                float g_factor = -1.0 / min(p_dot_u, -0.0001); 

                // 3. Asymmetric Brightness (Intensity scales by g^3)
                float beaming_intensity = (g_factor * g_factor * g_factor);
    
                // 4. Color Shifting (Blueshift vs Redshift)
                // Base emission shifted by g_factor. High g = blue/white, low g = deep red/dim
                vec3 shiftedEmission;
                shiftedEmission.r = baseEmission.r * (g_factor * sqrt(g_factor));
                shiftedEmission.g = baseEmission.g * (g_factor * g_factor * sqrt(g_factor));
                shiftedEmission.b = baseEmission.b * (g_factor * g_factor * g_factor * g_factor);
    
                // Clamp to prevent blown-out artifacts near the singularity
                shiftedEmission = clamp(shiftedEmission * beaming_intensity, 0.0, 50.0);

                // Continue with standard volumetric integration
                float absorption = 1.2; 
                float stepOpticalDepth = density * absorption * dynamic_dt;
                float stepTransmittance = exp(-stepOpticalDepth);

                float emissionStr = 1.5;
                vec3 stepEmission = shiftedEmission * density * emissionStr * dynamic_dt;
    
                accumulatedColor += stepEmission * transmittance;
                transmittance *= stepTransmittance;
            }
        }

        // Early Ray Termination for Density:
        // If the gas is so thick it's fully opaque, stop calculating to save GPU cycles
        if (transmittance < 0.01) 
        {
            finalColor = vec4(accumulatedColor, 1.0);
            break;
        }

        //Escape check: if the photon is far enough away, sample the skybox for color
        // 3. Escape Check (Adjusted for geometric units and blending with accumulated volume)
        if(length(new_position.yzw) > 15.0 && dot(new_position.yzw, new_velocity.yzw) > 0.0)
        {
            vec3 dir = normalize(new_velocity.yzw);
            
            float gridX = step(0.95, fract(dir.x * 10.0));
            float gridY = step(0.95, fract(dir.y * 10.0));
            float gridZ = step(0.95, fract(dir.z * 10.0));
            float combinedGrid = clamp(gridX + gridY + gridZ, 0.0, 1.0);
            
            vec3 backgroundGrid = vec3(0.0, 0.1, 0.2) + combinedGrid;
            
            // The final color is the glowing gas PLUS the background grid shining through it
            finalColor = vec4(accumulatedColor + backgroundGrid * transmittance, 1.0);
            break; 
        }
        position = new_position;
        velocity = new_velocity;
    }

    // Write the computed color to the pixel
    imageStore(imgOutput, pixelCoords, finalColor);
}