#version 430 core

// 8x8 local workgroup matches the dispatch in Main.cpp
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
// Output texture
layout(rgba32f, binding = 0) uniform image2D imgOutput;

layout(binding = 1) uniform samplerCube skybox; // Cubemap for the starfield background

uniform vec3 bhPosition;
uniform float bhMass;
uniform float dt; // Time step for the simulation

uniform vec3 camPos;
uniform vec3 camFront;
uniform vec3 camUp;
uniform vec3 camRight;

const float G = 6.67430e-11;
const float c = 299792458.0;

float get_rs() {
    return (2.0 * G * bhMass) / (c * c);
}

vec3 getAcceleration(vec3 position, vec3 velocity)
{
    vec3 r_vec_current = position - bhPosition;
    float r_current = length(r_vec_current);
    vec3 cross_product = cross(r_vec_current, velocity);
    float h2 = dot(cross_product, cross_product);
    float rs = get_rs();
    float coeff = -1.5 * rs * h2 / pow(r_current, 5.0);
    return coeff * r_vec_current;
}

void main()
{
    ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dims = imageSize(imgOutput);
    
    // Ensure we don't write outside the texture bounds
    if(pixelCoords.x >= dims.x || pixelCoords.y >= dims.y) return;

    // Remove the aspect multiplication from uv.x since we handle it in the ray direction
    vec2 uv = vec2(pixelCoords) / vec2(dims) * 2.0 - 1.0;
    float aspect = float(dims.x) / float(dims.y);

    // Calculate direction based on the camera's basis vectors
    vec3 rayDir = normalize(camFront + uv.x * aspect * camRight + uv.y * camUp);

    vec3 position = camPos; 
    vec3 velocity = rayDir * 0.01; // Initial photon speed
    vec4 finalColor = vec4(0.0, 0.0, 0.0, 1.0); // Default to black
    
    float rs = get_rs();
    const int MAX_STEPS = 10000; // Prevent infinite loops

    for(int step = 0; step < MAX_STEPS; step++)
    {
        // 1. RK4 Integration
        vec3 k1_v = getAcceleration(position, velocity);
        vec3 k1_p = velocity;

        vec3 k2_v = getAcceleration(position + k1_p * (dt * 0.5), velocity + k1_v * (dt * 0.5));
        vec3 k2_p = velocity + k1_v * (dt * 0.5);

        vec3 k3_v = getAcceleration(position + k2_p * (dt * 0.5), velocity + k2_v * (dt * 0.5));
        vec3 k3_p = velocity + k2_v * (dt * 0.5);

        vec3 k4_v = getAcceleration(position + k3_p * dt, velocity + k3_v * dt);
        vec3 k4_p = velocity + k3_v * dt;

        vec3 new_velocity = velocity + (dt / 6.0) * (k1_v + 2.0 * k2_v + 2.0 * k3_v + k4_v);
        vec3 new_position = position + (dt / 6.0) * (k1_p + 2.0 * k2_p + 2.0 * k3_p + k4_p);

        // 2. Event Horizon Check
        float r = length(new_position - bhPosition);
        if(r <= rs)
        {
            finalColor = vec4(0.0, 0.0, 0.0, 1.0); // Pitch black
            break; 
        }

        // 3. Accretion Disk Check (Equatorial crossing)
        if (position.y * new_position.y <= 0.0) 
        {
            if (r > 1.5 * rs && r < 4.0 * rs) 
            {
                float v_orb = sqrt(G * bhMass / r);
                vec3 r_dir = normalize(vec3(new_position.x, 0.0, new_position.z));
                vec3 v_vec = v_orb * vec3(-r_dir.z, 0.0, r_dir.x); 
                
                vec3 beta = v_vec / c;
                float beta_mag = length(beta);
                float gamma = 1.0 / sqrt(1.0 - beta_mag * beta_mag);
                
                vec3 photon_dir = normalize(-velocity);
                float doppler = 1.0 / (gamma * (1.0 - dot(beta, photon_dir)));
                float intensity = pow(doppler, 3.0);
                
                vec3 diskBaseColor = vec3(1.0, 0.4, 0.1); 
                finalColor = vec4(diskBaseColor * intensity, 1.0);
                break; // Stop tracing once it hits the solid disk
            }
        }

        // 4. Escape Check (Ray leaves the simulation area)
        if(abs(new_position.x) > 20.0 || abs(new_position.y) > 20.0 || abs(new_position.z) > 20.0)
        {
            vec3 dir = normalize(new_velocity);
    
            // Creates a 3D grid pattern to clearly visualize the gravitational distortion
            float gridX = step(0.95, fract(dir.x * 10.0));
            float gridY = step(0.95, fract(dir.y * 10.0));
            float gridZ = step(0.95, fract(dir.z * 10.0));
    
            float combinedGrid = clamp(gridX + gridY + gridZ, 0.0, 1.0);
    
            // Output a white grid on a dark blue background
            finalColor = vec4(vec3(0.0, 0.1, 0.2) + combinedGrid, 1.0);
            break; 
        }

        position = new_position;
        velocity = new_velocity;
    }

    // Write the computed color to the pixel
    imageStore(imgOutput, pixelCoords, finalColor);
}