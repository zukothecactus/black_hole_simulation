#version 430 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(rgba32f, binding = 0) uniform image2D imgOutput;
layout(binding = 1) uniform samplerCube skybox; 

uniform vec3 bhPosition;

// Mass is now strictly 1.0 (Geometric units)
const float M = 1.0; 

// Spin parameter (0.0 = static, 0.99 = max spin)
uniform float spin = 0.99; 

// Time step needs to be much smaller in geometric units
uniform float dt = 0.05; 

uniform vec3 camPos;
uniform vec3 camFront;
uniform vec3 camUp;
uniform vec3 camRight;

// 1. Solve for Boyer-Lindquist radial coordinate 'r'
float get_r(vec3 pos, float a) {
    float R2 = dot(pos, pos);
    float a2 = a * a;
    float z2 = pos.z * pos.z;
    
    // Explicit solution to the implicit Kerr coordinate equation
    float r2 = 0.5 * (R2 - a2 + sqrt(pow(R2 - a2, 2.0) + 4.0 * a2 * z2));
    return sqrt(max(r2, 0.0001)); // Clamp to prevent division by zero at the singularity
}

// 2. Calculate the Kerr-Schild Metric Tensor g_mu_nu
mat4 get_metric(vec4 pos4) {
    vec3 pos = pos4.yzw; // pos4 is (t, x, y, z)
    float a = spin * M;
    float r = get_r(pos, a);
    
    float r2 = r * r;
    float a2 = a * a;
    
    // Scalar potential function f
    float f = (2.0 * M * r * r2) / (r2 * r2 + a2 * pos.z * pos.z);
    
    // Null vector l_mu
    float denom = r2 + a2;
    vec4 l = vec4(
        1.0, 
        (r * pos.x + a * pos.y) / denom, 
        (r * pos.y - a * pos.x) / denom, 
        pos.z / r
    );
    
    // Minkowski metric eta_mu_nu
    mat4 eta = mat4(0.0);
    eta[0][0] = -1.0;
    eta[1][1] = 1.0;
    eta[2][2] = 1.0;
    eta[3][3] = 1.0;
    
    // Construct g_mu_nu = eta_mu_nu + f * l_mu * l_nu
    mat4 g = eta;
    for(int i = 0; i < 4; i++) {
        for(int j = 0; j < 4; j++) {
            g[i][j] += f * l[i] * l[j];
        }
    }
    return g;
}

// 3. Calculate 4D Geodesic Acceleration using Numerical Derivatives
vec4 getAcceleration(vec4 pos, vec4 vel) {
    float eps = 0.005; // Finite difference step size
    
    mat4 g = get_metric(pos);
    mat4 g_inv = inverse(g);
    
    // Calculate partial derivatives of the metric (dg / dx^alpha)
    mat4 dg_dx[4];
    for(int i = 0; i < 4; i++) {
        vec4 pos_plus = pos;
        vec4 pos_minus = pos;
        pos_plus[i] += eps;
        pos_minus[i] -= eps;
        
        dg_dx[i] = (get_metric(pos_plus) - get_metric(pos_minus)) / (2.0 * eps);
    }
    
    vec4 acc = vec4(0.0);
    // Contract the Christoffel symbols with the 4-velocity
    for(int mu = 0; mu < 4; mu++) {
        for(int alpha = 0; alpha < 4; alpha++) {
            for(int beta = 0; beta < 4; beta++) {
                float christoffel = 0.0;
                for(int rho = 0; rho < 4; rho++) {
                    christoffel += 0.5 * g_inv[mu][rho] * (
                        dg_dx[beta][alpha][rho] + 
                        dg_dx[alpha][beta][rho] - 
                        dg_dx[rho][alpha][beta]
                    );
                }
                acc[mu] -= christoffel * vel[alpha] * vel[beta];
            }
        }
    }
    return acc;
}

void main()
{
    ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dims = imageSize(imgOutput);
    
    // Ensure we don't write outside the texture bounds
    if(pixelCoords.x >= dims.x || pixelCoords.y >= dims.y) return;

    // Remove the aspect multiplication from uv.x since we handle it in the ray direction
    vec2 uv = vec2(pixelCoords) / vec2(dims) * 2.0 - 1.0;
    float aspect = float(dims.x) / float(dims.y);

    // Calculate direction based on the camera's basis vectors
    vec3 rayDir = normalize(camFront + uv.x * aspect * camRight + uv.y * camUp);

    vec4 position = vec4(0.0, camPos.x, camPos.y, camPos.z); //Initial photon position in 4D (t, x, y, z)
    vec4 velocity = vec4(1.0, rayDir.x, rayDir.y, rayDir.z); // Initial photon speed
    vec4 finalColor = vec4(0.0, 0.0, 0.0, 1.0); // Default to black
    
    float a = spin * M; // Spin parameter
    float event_horizon = M + sqrt(M * M - a * a); // Event horizon radius

    const int MAX_STEPS = 10000; // Prevent infinite loops

    for(int step = 0; step < MAX_STEPS; step++)
    {
        float r_current = length(position.yzw); // Current radial distance from the black hole

        // Dynamically scale the step size:
        // Close to the black hole, multiplier is 1.0 (fine precision).
        // Far away, the multiplier scales up, allowing massive leaps through empty space.
        float dynamic_dt = dt * max(1.0, r_current / 3.0);

        // 1. RK4 Integration
        vec4 k1_v = getAcceleration(position, velocity);
        vec4 k1_p = velocity;

        vec4 k2_v = getAcceleration(position + k1_p * (dynamic_dt * 0.5), velocity + k1_v * (dynamic_dt * 0.5));
        vec4 k2_p = velocity + k1_v * (dynamic_dt * 0.5);

        vec4 k3_v = getAcceleration(position + k2_p * (dynamic_dt * 0.5), velocity + k2_v * (dynamic_dt * 0.5));
        vec4 k3_p = velocity + k2_v * (dynamic_dt * 0.5);
        vec4 k4_v = getAcceleration(position + k3_p * dynamic_dt, velocity + k3_v * dynamic_dt);
        vec4 k4_p = velocity + k3_v * dynamic_dt;

        vec4 new_velocity = velocity + (dynamic_dt / 6.0) * (k1_v + 2.0 * k2_v + 2.0 * k3_v + k4_v);
        vec4 new_position = position + (dynamic_dt / 6.0) * (k1_p + 2.0 * k2_p + 2.0 * k3_p + k4_p);

        // 2. Event Horizon Check (Boyer-Lindquist radial coordinate))
        float r = get_r(new_position.yzw, a);
        if(r <= event_horizon * 1.05) //small padding to prevent precision collapse at singularity
        {
            finalColor = vec4(0.0, 0.0, 0.0, 1.0); // Black for inside the event horizon
            break; // Stop tracing once it crosses the event horizon
        }
        
        //Escape check: if the photon is far enough away, sample the skybox for color
        // 2. Escape Check (Adjusted for geometric units)
        if(length(new_position.yzw) > 50.0)
        {
            vec3 dir = normalize(new_velocity.yzw);
    
            if(length(new_position.yzw) > 15.0 && dot(new_position.yzw, new_velocity.yzw) > 0.0)
            {
                // Procedural 3D grid
                float gridX = step(0.95, fract(dir.x * 10.0));
                float gridY = step(0.95, fract(dir.y * 10.0));
                float gridZ = step(0.95, fract(dir.z * 10.0));

                // If the ray is far enough away AND its velocity is pointing outward
                float combinedGrid = clamp(gridX + gridY + gridZ, 0.0, 1.0);
    
                finalColor = vec4(vec3(0.0, 0.1, 0.2) + combinedGrid, 1.0);
                break; 
            }
        }

        position = new_position;
        velocity = new_velocity;
    }

    // Write the computed color to the pixel
    imageStore(imgOutput, pixelCoords, finalColor);
}