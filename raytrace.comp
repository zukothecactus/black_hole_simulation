// 1. Solve for Boyer-Lindquist radial coordinate 'r'
float get_r(vec3 pos, float a) {
    float R2 = dot(pos, pos);
    float a2 = a * a;
    float z2 = pos.z * pos.z;
    
    // Explicit solution to the implicit Kerr coordinate equation
    float r2 = 0.5 * (R2 - a2 + sqrt(pow(R2 - a2, 2.0) + 4.0 * a2 * z2));
    return sqrt(max(r2, 0.0001)); // Clamp to prevent division by zero at the singularity
}

// 2. Calculate the Kerr-Schild Metric Tensor g_mu_nu
mat4 get_metric(vec4 pos4) {
    vec3 pos = pos4.yzw; // pos4 is (t, x, y, z)
    float a = spin * M;
    float r = get_r(pos, a);
    
    float r2 = r * r;
    float a2 = a * a;
    
    // Scalar potential function f
    float f = (2.0 * M * r * r2) / (r2 * r2 + a2 * pos.z * pos.z);
    
    // Null vector l_mu
    float denom = r2 + a2;
    vec4 l = vec4(
        1.0, 
        (r * pos.x + a * pos.y) / denom, 
        (r * pos.y - a * pos.x) / denom, 
        pos.z / r
    );
    
    // Minkowski metric eta_mu_nu
    mat4 eta = mat4(0.0);
    eta[0][0] = -1.0;
    eta[1][1] = 1.0;
    eta[2][2] = 1.0;
    eta[3][3] = 1.0;
    
    // Construct g_mu_nu = eta_mu_nu + f * l_mu * l_nu
    mat4 g = eta;
    for(int i = 0; i < 4; i++) {
        for(int j = 0; j < 4; j++) {
            g[i][j] += f * l[i] * l[j];
        }
    }
    return g;
}

